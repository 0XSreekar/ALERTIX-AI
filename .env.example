# ────────────────────────────────────────────────────────────────
# Alertix AI — Environment variables (copy to .env and fill in)
# ────────────────────────────────────────────────────────────────

# ─── Backend / Database ─────────────────────────────────────────
# Supabase Postgres connection string (async — postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alertix
# Sync variant used by Alembic
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/alertix

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Redis (Upstash in prod, local in dev) ──────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Object storage (Cloudflare R2) ─────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=alertix
R2_BUCKET=alertix
R2_PUBLIC_URL=

# ─── Internal cron token (GitHub Actions → backend) ─────────────
CRON_TOKEN=replace-with-a-long-random-string

# ─── LLM (Phase 2) ──────────────────────────────────────────────
# Production fallback ladder: Cerebras → Groq → Gemini → templated.
# All three are free, hosted, no laptop / Cloudflare-Tunnel required.
# Sign up:
#   Cerebras → https://cloud.cerebras.ai/   (2000 tok/s, 60K tok/min free)
#   Groq     → https://console.groq.com/    (300 tok/s, 30 req/min free)
#   Gemini   → https://aistudio.google.com/ (1500 req/day free)
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: set OLLAMA_PRIMARY=true to route requests to local Ollama first
# (dev only — the cloud providers above stay as fallback)
OLLAMA_PRIMARY=false
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TUNNEL_URL=

# ─── ML model checkpoints (Phase 2) ─────────────────────────────
# Paths to trained PyTorch weights. Train via ml/scripts/train_*.py
# or the notebooks under ml/notebooks/. If unset, prediction endpoints
# fall back to deterministic rules / passthrough.
SEISMIC_AE_CHECKPOINT=./models/seismic_ae.pt
FLOOD_LSTM_CHECKPOINT=./models/flood_lstm.pt
FLOOD_UNET_CHECKPOINT=
DAMAGE_MODEL_CHECKPOINT=

# ─── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@alertix.ai

# ─── Monitoring ─────────────────────────────────────────────────
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

# ─── App config ─────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
ENVIRONMENT=development              # alias — same values as APP_ENV
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ─── External API keys ──────────────────────────────────────────
NASA_FIRMS_MAP_KEY=
FIRMS_MAP_KEY=                       # alias for NASA_FIRMS_MAP_KEY
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
CWC_FLOOD_DASHBOARD_URL=https://cwc.gov.in/ffm_dashboard
CWC_DAILY_REPORT_URL=https://cwc.gov.in/fmo/dfsra
STATE_FLOOD_BULLETIN_URLS=
WEATHER_INGEST_POINTS=

# ─── Error tracking ─────────────────────────────────────────────
SENTRY_DSN=

# ─── Frontend (Vite — VITE_ prefix required) ────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...
VITE_SENTRY_DSN=
